{
  "id": "com.mailpoppy.desktop",
  "name": "MailPoppy",
  "version": "0.1.26",
  "description": "Run your own private mail backend on your AWS account — deploy, manage, and tear it down.",
  "icon": "frontend/mailpoppy-icon.png",
  "bugsUrl": "https://github.com/leonct74/mailpoppy-public-source/issues",
  "permissionSet": {
    "id": "mailpoppy-backend",
    "name": "MailPoppy backend",
    "description": "Deploy & manage the MailPoppy mail backend, scoped to MailpoppyMailStack-* / mailpoppy* resources. It also applies your AgentsPoppy safety limit to the roles it creates, so they can never be given more access than you have allowed. If you also use CrewPoppy, mail addressed to an agent-owned mailbox is handed to your CrewPoppy agents. MailPoppy can start your agents; it can never read their data or touch anything else of theirs.",
    "grants": [
      {
        "service": "cloudformation",
        "actions": [
          "CreateStack",
          "UpdateStack",
          "DeleteStack",
          "DescribeStacks",
          "DescribeStackEvents",
          "DescribeStackResources",
          "ListStackResources",
          "GetTemplate",
          "CreateChangeSet",
          "DescribeChangeSet",
          "ExecuteChangeSet",
          "DeleteChangeSet",
          "TagResource"
        ],
        "resourceScope": "arn:aws:cloudformation:*:*:stack/MailpoppyMailStack/*"
      },
      {
        "service": "cloudformation",
        "actions": [
          "ValidateTemplate",
          "GetTemplateSummary"
        ],
        "resourceScope": "*",
        "reason": "Before deploying, MailPoppy asks AWS to double-check its own deployment plan, so a mistake is caught before anything is created in your account."
      },
      {
        "service": "iam",
        "actions": [
          "CreateRole",
          "DeleteRole",
          "GetRole",
          "TagRole",
          "UntagRole",
          "AttachRolePolicy",
          "DetachRolePolicy",
          "PutRolePolicy",
          "DeleteRolePolicy",
          "GetRolePolicy",
          "ListRolePolicies",
          "ListAttachedRolePolicies",
          "PassRole",
          "PutRolePermissionsBoundary",
          "DeleteRolePermissionsBoundary"
        ],
        "resourceScope": "arn:aws:iam::*:role/MailpoppyMailStack-*"
      },
      {
        "service": "iam",
        "actions": [
          "SimulatePrincipalPolicy"
        ],
        "resourceScope": "*",
        "reason": "During setup, MailPoppy asks AWS whether the credentials you connected have enough access to finish the job — so you find out at the start, not halfway through."
      },
      {
        "service": "lambda",
        "actions": [
          "CreateFunction",
          "DeleteFunction",
          "GetFunction",
          "GetFunctionConfiguration",
          "UpdateFunctionCode",
          "UpdateFunctionConfiguration",
          "AddPermission",
          "RemovePermission",
          "InvokeFunction",
          "TagResource",
          "UntagResource",
          "ListTags"
        ],
        "resourceScope": "arn:aws:lambda:*:*:function:MailpoppyMailStack-*"
      },
      {
        "service": "lambda",
        "actions": [
          "InvokeFunction"
        ],
        "resourceScope": "arn:aws:lambda:*:*:function:CrewPoppyRunner"
      },
      {
        "service": "dynamodb",
        "actions": [
          "CreateTable",
          "DeleteTable",
          "DescribeTable",
          "UpdateTable",
          "DescribeContinuousBackups",
          "UpdateContinuousBackups",
          "DescribeTimeToLive",
          "UpdateTimeToLive",
          "TagResource",
          "UntagResource",
          "ListTagsOfResource",
          "GetItem",
          "BatchGetItem",
          "PutItem",
          "UpdateItem",
          "DeleteItem",
          "Query",
          "Scan",
          "BatchWriteItem",
          "ConditionCheckItem"
        ],
        "resourceScope": "arn:aws:dynamodb:*:*:table/MailpoppyMailStack-*"
      },
      {
        "service": "dynamodb",
        "actions": [
          "Query",
          "Scan"
        ],
        "resourceScope": "arn:aws:dynamodb:*:*:table/MailpoppyMailStack-*/index/*"
      },
      {
        "service": "logs",
        "actions": [
          "CreateLogGroup",
          "DeleteLogGroup",
          "DescribeLogGroups",
          "PutRetentionPolicy",
          "TagResource"
        ],
        "resourceScope": "arn:aws:logs:*:*:log-group:/aws/lambda/MailpoppyMailStack-*"
      },
      {
        "service": "sns",
        "actions": [
          "CreateTopic",
          "DeleteTopic",
          "Subscribe",
          "Unsubscribe",
          "GetTopicAttributes",
          "SetTopicAttributes",
          "GetSubscriptionAttributes",
          "TagResource",
          "UntagResource"
        ],
        "resourceScope": "arn:aws:sns:*:*:MailpoppyMailStack-*"
      },
      {
        "service": "events",
        "actions": [
          "PutRule",
          "DeleteRule",
          "DescribeRule",
          "PutTargets",
          "RemoveTargets",
          "ListTargetsByRule",
          "TagResource",
          "UntagResource"
        ],
        "resourceScope": "arn:aws:events:*:*:rule/MailpoppyMailStack-*"
      },
      {
        "service": "apigateway",
        "actions": [
          "POST",
          "GET",
          "PATCH",
          "PUT",
          "DELETE"
        ],
        "resourceScope": "arn:aws:apigateway:*::/apis*"
      },
      {
        "service": "apigateway",
        "actions": [
          "POST",
          "GET",
          "PATCH",
          "PUT",
          "DELETE"
        ],
        "resourceScope": "arn:aws:apigateway:*::/v2/apis*"
      },
      {
        "service": "apigateway",
        "actions": [
          "POST",
          "GET",
          "PATCH",
          "PUT",
          "DELETE"
        ],
        "resourceScope": "arn:aws:apigateway:*::/tags*"
      },
      {
        "service": "s3",
        "actions": [
          "CreateBucket",
          "DeleteBucket",
          "PutBucketPolicy",
          "GetBucketPolicy",
          "DeleteBucketPolicy",
          "PutEncryptionConfiguration",
          "GetEncryptionConfiguration",
          "PutBucketPublicAccessBlock",
          "GetBucketPublicAccessBlock",
          "PutBucketTagging",
          "PutLifecycleConfiguration",
          "GetLifecycleConfiguration",
          "PutBucketCORS",
          "GetBucketCORS",
          "ListBucket",
          "HeadBucket"
        ],
        "resourceScope": "arn:aws:s3:::mailpoppy*"
      },
      {
        "service": "s3",
        "actions": [
          "GetObject",
          "PutObject",
          "DeleteObject"
        ],
        "resourceScope": "arn:aws:s3:::mailpoppy*/*"
      },
      {
        "service": "s3",
        "actions": [
          "ListAllMyBuckets"
        ],
        "resourceScope": "*",
        "reason": "During setup, MailPoppy looks through your storage bucket names to find its own and avoid a name clash. Names only — it never sees what is inside a bucket."
      },
      {
        "service": "cognito-idp",
        "actions": [
          "CreateUserPool",
          "CreateUserPoolClient",
          "DescribeUserPool",
          "DescribeUserPoolClient",
          "GetUserPoolMfaConfig",
          "TagResource",
          "UntagResource",
          "ListUsers"
        ],
        "resourceScope": "*",
        "reason": "Creates the sign-in directory your mailboxes live in. Changing or deleting a directory is a separate permission, limited to the one MailPoppy itself created."
      },
      {
        "service": "cognito-idp",
        "actions": [
          "DeleteUserPool",
          "UpdateUserPool",
          "DeleteUserPoolClient",
          "UpdateUserPoolClient",
          "SetUserPoolMfaConfig",
          "AdminCreateUser",
          "AdminSetUserPassword",
          "AdminDeleteUser"
        ],
        "resourceScope": "tagged-as-self"
      },
      {
        "service": "ses",
        "actions": [
          "CreateReceiptRuleSet",
          "CreateReceiptRule",
          "DeleteReceiptRule",
          "DeleteReceiptRuleSet",
          "DescribeReceiptRuleSet",
          "DescribeActiveReceiptRuleSet",
          "SetActiveReceiptRuleSet",
          "CreateEmailIdentity",
          "GetEmailIdentity",
          "DeleteEmailIdentity",
          "ListEmailIdentities",
          "GetAccount",
          "GetSendStatistics",
          "PutAccountDetails",
          "PutEmailIdentityMailFromAttributes",
          "SendEmail",
          "SetIdentityNotificationTopic",
          "SetIdentityHeadersInNotificationsEnabled",
          "DeleteSuppressedDestination"
        ],
        "resourceScope": "*",
        "reason": "Sets up email for your domain: where incoming mail gets delivered, proving to other mail servers that your domain is really yours, and sending your outgoing mail."
      },
      {
        "service": "route53",
        "actions": [
          "ListHostedZonesByName",
          "ListResourceRecordSets",
          "ChangeResourceRecordSets"
        ],
        "resourceScope": "*",
        "reason": "Adds the DNS records that make email work for your domain — and reads what is already there first, so you can see what will change before it does."
      },
      {
        "service": "guardduty",
        "actions": [
          "CreateMalwareProtectionPlan",
          "GetMalwareProtectionPlan",
          "UpdateMalwareProtectionPlan",
          "DeleteMalwareProtectionPlan",
          "ListMalwareProtectionPlans",
          "TagResource",
          "UntagResource",
          "ListTagsForResource"
        ],
        "resourceScope": "*",
        "reason": "Turns on the optional virus scanning of mail attachments, if you choose it — and turns it off again when you remove MailPoppy."
      },
      {
        "service": "sts",
        "actions": [
          "GetCallerIdentity"
        ],
        "resourceScope": "*",
        "reason": "Checks which AWS account it is connected to, so setup can show you where it is about to work before it starts."
      }
    ],
    "requiredTags": [
      "agentspoppy:account",
      "agentspoppy:app",
      "agentspoppy:connection"
    ],
    "limits": null,
    "network": {
      "egress": "aws-only",
      "infrastructure": "email"
    }
  },
  "frontend": {
    "entry": "frontend/index.html"
  },
  "backend": {
    "entry": "backend/index.cjs",
    "transport": "http",
    "runtime": "node22",
    "isolation": "strict"
  },
  "teardown": {
    "endpoint": "/teardown"
  },
  "capabilities": [
    "aws:credentials",
    "connection:read",
    "backend:invoke",
    "host:openExternal",
    "host:notify"
  ]
}
